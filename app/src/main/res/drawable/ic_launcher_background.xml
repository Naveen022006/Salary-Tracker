<?xml version="1.0" encoding="utf-8"?>
<!-- Salary Tracker launcher background - system-blue glass gradient.
     Goes in res/drawable/. Reference it as @drawable/ic_launcher_background from the
     adaptive icon. Flat fallback (and the value for @color/ic_launcher_background if you
     prefer a plain colour): #FF007AFF. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- diagonal blue gradient -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2E9BFF" />
                <item android:offset="1" android:color="#FF0057D6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft top-left sheen -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="22"
                android:gradientRadius="81">
                <item android:offset="0" android:color="#38FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
